# Copy to .env, which compose.yaml reads and git ignores.
POSTGRES_USER=corvo
POSTGRES_DB=corvo
# In production, use a generated password, such as the output of:
# openssl rand -hex 32
POSTGRES_PASSWORD=corvo

# Hatchet's PostgreSQL. The user and the password go in a URL, so they must
# not need escaping: in production, use the output of openssl rand -hex 32 for
# the password.
HATCHET_POSTGRES_USER=hatchet
HATCHET_POSTGRES_DB=hatchet
HATCHET_POSTGRES_PASSWORD=hatchet

# The admin of Hatchet's dashboard, created on the first start. The password
# needs 8 to 64 characters, with an uppercase letter, a lowercase letter and
# a number.
HATCHET_ADMIN_EMAIL=admin@example.com
HATCHET_ADMIN_PASSWORD=Hatchet123

# Hatchet's message queue: postgres, or rabbitmq with a RabbitMQ compose.yaml
# does not run.
HATCHET_MSGQUEUE_KIND=postgres
# Where the dashboard is reached. Without TLS in front of it, its cookie must
# be insecure (t); behind HTTPS, set f.
HATCHET_SERVER_URL=http://localhost:8080
HATCHET_AUTH_COOKIE_DOMAIN=localhost:8080
HATCHET_AUTH_COOKIE_INSECURE=t
# f: only the admin, and whoever the admin invites, gets an account.
HATCHET_ALLOW_SIGNUP=f

# The engine's gRPC, without TLS (t), as the workers reach it inside compose.
HATCHET_GRPC_BIND_ADDRESS=0.0.0.0
HATCHET_GRPC_INSECURE=t
# The address the workers dial, by the engine's service name. A change to it
# calls for new API tokens.
HATCHET_GRPC_BROADCAST_ADDRESS=hatchet-engine:7070
HATCHET_INTERNAL_GRPC_BROADCAST_ADDRESS=hatchet-engine:7070
